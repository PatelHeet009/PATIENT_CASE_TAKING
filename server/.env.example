# Server port
PORT=4000

# JWT signing secret — change this to a long random string in production
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=8h

# Comma-separated list of allowed frontend origins (Vite dev server default shown)
CORS_ORIGIN=http://localhost:3000

# Path to the SQLite database file (created automatically on first run)
DB_PATH=./data/app.db

# Set to "true" to wipe and reseed the database with demo data on every boot
RESEED_ON_START=false
